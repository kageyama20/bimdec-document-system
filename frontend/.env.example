# Copy to frontend/.env for local development.
#
# These are BUILD-TIME values: Vite inlines them into the bundle, so anything
# here is publicly readable once deployed. Never put a secret in this file —
# the backend API key and the Supabase service_role key must never appear here.
#
# On Render these same keys are set on the static site under `envVars` in
# /render.yaml, and are applied when the site is built.

# Supabase project — Dashboard > Project Settings > API.
# The "anon"/publishable key is safe to expose; it only grants what the RLS
# policies in database/supabase-schema.sql allow.
VITE_SUPABASE_URL=https://ygsufcxhvsdfjlhoekxd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_JDyd5wTlqBJV80EC7YCyow_326MVpRc

# Default URL of the email backend service (see /backend). Admins can still
# override this per-browser on the Email page under "Connection settings";
# this value is only the fallback when they haven't. The matching API key is
# NOT set here — each admin enters it once, and it stays in their browser.
VITE_API_BASE=https://bimdec-email.onrender.com
