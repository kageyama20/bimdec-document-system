# Copy this file to .env for local testing.
# On Render/Railway, set these as real Environment Variables in the
# service's dashboard instead of committing a .env file. NEVER commit
# a real .env with real credentials to git.

# --- Server ---
PORT=8080
# Comma-separated list of origins allowed to call this API. Exact string
# match — no wildcards, no trailing slash, scheme included. This also gates
# the Socket.IO handshake, so a missing origin kills the live inbox too.
#
# WARNING: leaving this EMPTY allows every origin (see server.js). Always set
# it to the real portal URL, e.g. the Render static site plus localhost for
# development:
ALLOWED_ORIGINS=http://localhost:5173,https://bimdec-portal.onrender.com
# Shared secret the admin portal sends as the X-Api-Key header.
# Generate a long random string — this is what stops strangers from
# using your mail server through this API.
API_KEY=change-this-to-a-long-random-string

# --- SMTP (sending mail) ---
SMTP_HOST=shu23.u-srv.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@bimphilippines.org
SMTP_PASS=your-mailbox-password
# Optional: override the From header shown to recipients (defaults to SMTP_USER)
SMTP_FROM_NAME=BIMDEC Document System

# --- IMAP (reading mail) ---
IMAP_HOST=shu23.u-srv.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=admin@bimphilippines.org
IMAP_PASS=your-mailbox-password
# Which mailbox folder to watch
IMAP_MAILBOX=INBOX
# How many recent messages to load into memory on first check
IMAP_INITIAL_FETCH=30
# "poll" (default) works on Render/Railway's FREE tier: checks the mailbox
# whenever the admin portal asks for the inbox (no persistent connection).
# "idle" keeps one connection open for instant push — only use this if
# you've upgraded to an ALWAYS-ON (paid) instance, since free instances
# sleep and drop the connection anyway.
IMAP_MODE=poll
# poll mode only: minimum seconds between real checks of the mail server,
# even if the dashboard is refreshing more often than that.
IMAP_POLL_INTERVAL_SECONDS=20
